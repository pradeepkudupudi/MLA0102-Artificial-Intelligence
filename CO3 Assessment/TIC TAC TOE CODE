board = [" "]*9

def check(b,p):
    wins=[[0,1,2],[3,4,5],[6,7,8],
          [0,3,6],[1,4,7],[2,5,8],
          [0,4,8],[2,4,6]]
    return any(all(b[i]==p for i in w) for w in wins)

def minimax(b,isMax):

    if check(b,"O"):
        return 1

    if check(b,"X"):
        return -1

    if " " not in b:
        return 0

    if isMax:
        best=-100
        for i in range(9):
            if b[i]==" ":
                b[i]="O"
                best=max(best,minimax(b,False))
                b[i]=" "
        return best
    else:
        best=100
        for i in range(9):
            if b[i]==" ":
                b[i]="X"
                best=min(best,minimax(b,True))
                b[i]=" "
        return best

print("Minimax Evaluation =", minimax(board,True))
