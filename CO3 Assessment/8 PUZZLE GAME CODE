from queue import PriorityQueue

goal = [1,2,3,4,5,6,7,8,0]

start = [1,2,3,
         4,5,6,
         0,7,8]

def heuristic(state):
    count = 0
    for i in range(9):
        if state[i] != 0 and state[i] != goal[i]:
            count += 1
    return count

pq = PriorityQueue()

pq.put((heuristic(start), start))

visited = set()

while not pq.empty():

    cost, state = pq.get()

    t = tuple(state)

    if t in visited:
        continue

    visited.add(t)

    if state == goal:
        print("Puzzle Solved!")
        break

    zero = state.index(0)

    moves = []

    if zero > 2:
        moves.append(zero-3)

    if zero < 6:
        moves.append(zero+3)

    if zero % 3 != 0:
        moves.append(zero-1)

    if zero % 3 != 2:
        moves.append(zero+1)

    for m in moves:

        new = state[:]

        new[zero], new[m] = new[m], new[zero]

        pq.put((heuristic(new), new))
